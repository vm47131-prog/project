
<% layout("/layouts/boilerplate") %>

<div class="container mt-3 mb-4">
  <div class="row">
    <!-- Food Details -->
    <div class="card listing-card col-md-8 mt-2">
      <div class="card-body">
        <span class="badge <%= food.isVeg ? 'bg-success' : 'bg-danger' %>">
          <%= food.isVeg ? "Veg" : "Non-Veg" %>
        </span>

        <h4 class="card-title mt-2"><%= food.name %></h4>

        <p class="card-text">
          <%= food.description %>
        </p>

        <p class="card-text">
          <b>Restaurant:</b> <%= food.restaurant %>
        </p>

        <p class="card-text">
          <b>Category:</b> <%= food.category %>
        </p>

        <p class="card-text">
          <b>Price:</b> ₹<%= food.price.toLocaleString("en-IN") %>
        </p>

        <p class="card-text">
          <b>Delivery Time:</b> <%= food.deliveryTime %>
        </p>

        <p class="card-text">
          <b>Rating:</b> <%= food.rating %> ★
        </p>

        <% if (food.owner) { %>
          <p class="card-text">
            <b>Added By:</b>
            <i><%= food.owner.username %></i>
          </p>
        <% } %>

      </div>
    </div>
  </div>

  <!-- Edit and Delete: Only food owner -->
  <% if (currUser && food.owner &&
      food.owner._id.toString() === currUser._id.toString()) { %>
    <div class="row mt-3">
      <div class="col-auto">
        <a href="/listings/<%= food._id %>/edit"
           class="btn btn-dark">
          Edit Food
        </a>
      </div>

      <div class="col-auto">
        <form method="POST"
              action="/listings/<%= food._id %>?_method=DELETE">
          <button type="submit" class="btn btn-dark delete-btn">
            Delete Food
          </button>
        </form>
      </div>
    </div>

  <% } %>

  <hr>

  
<!-- Add Review -->
<% if (currUser) { %>
  <div class="col-md-8">
    <h4>Leave a Review</h4>

    <form
      action="/listings/<%= food._id %>/reviews"
      method="POST"
      class="needs-validation"
      novalidate
    >
      <!-- Rating -->
      <div class="bg-white p-3 border rounded shadow-sm">
        <label for="rating" class="form-label fw-bold">
          Your Rating
        </label>

        <input
          type="range"
          min="1"
          max="5"
          step="1"
          id="rating"
          name="review[rating]"
          class="form-range"
          value="5"
          required
        >

        <div class="d-flex justify-content-between small fw-bold">
          <span>1 ★</span>
          <span>2 ★</span>
          <span>3 ★</span>
          <span>4 ★</span>
          <span>5 ★</span>
        </div>
      </div>

      <!-- Comment -->
      <div class="mb-3 mt-3">
        <label for="comment" class="form-label">
          Comments
        </label>

        <textarea
          name="review[comment]"
          id="comment"
          rows="4"
          class="form-control"
          placeholder="Write your experience..."
          required
        ></textarea>

        <div class="invalid-feedback">
          Please add some comments for your review.
        </div>
      </div>

      <button type="submit" class="btn btn-outline-dark">
        Submit Review
      </button>
    </form>
  </div>

  <hr>
<% } else { %>
  <p>
    <a href="/login">Login</a> to leave a review.
  </p>
<% } %>

<!-- All Reviews -->
<div class="mt-3">
  <h4>All Reviews</h4>

  <% if (food.reviews && food.reviews.length > 0) { %>
    <div class="row">
      <% for (let review of food.reviews) { %>
        <div class="col-md-5 mb-3 ">
          <div class="card h-100 px-2">
            <div class="card-body">

              <h5 class="card-title">
                @<%= review.author
                  ? review.author.username
                  : "User" %>
              </h5>

              <p class="card-text">
                <%= review.comment %>
              </p>

              <p class="card-text">
                <b>Rating:</b> <%= review.rating %> ★
              </p>

              <!-- Delete only your own review -->
              <% if (
                currUser &&
                review.author &&
                review.author._id.toString() === currUser._id.toString()
              ) { %>
                <form
                  method="POST"
                  action="/listings/<%= food._id %>/reviews/<%= review._id %>?_method=DELETE"
                >
                  <button type="submit" class="btn btn-sm btn-dark">
                    Delete Review
                  </button>
                </form>
              <% } %>

            </div>
          </div>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <p>No reviews yet. Be the first to review this food!</p>
  <% } %>
</div>
